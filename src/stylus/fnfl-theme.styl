// Mortar public : thème sombre de Vuetify en vert béret commando marine au lieu des gris Material
// (le calculateur privé est en bleu marine FNFL, le partagé en rouge foncé).
// Chargé avant chaque feuille stylus de Vuetify (vue.config.js, css.loaderOptions.stylus.import) : comme Vuetify
// déclare $material-dark avec « := » (seulement si absent), c'est cette version qui est utilisée partout.
// Copie de node_modules/vuetify/src/stylus/settings/_theme.styl, gris remplacés :
//   #212121 -> #0b1a0e   #303030 -> #0f2213   #424242 -> #1a3a22   #616161 -> #285a34   #757575 -> #336b40
$material-dark := {
  status-bar: {
    regular: #000,
    lights-out: rgba(#000, .2)
  },
  app-bar: #0b1a0e,
  background: #0f2213,
  cards: #1a3a22,
  chips: {
    background: #264b30,
    color: #fff
  },
  dividers: rgba(#fff, .12),
  text: {
    theme: #fff,
    primary: #fff,
    secondary: rgba(#fff, .70),
    disabled: rgba(#fff, .50),
    link: #82b1ff,
    link-hover: #eeeeee
  },
  icons: {
    active: #fff,
    inactive: rgba(#fff, .5)
  },
  inputs: {
    box: #fff,
    solo-inverted: rgba(#fff, .16),
    solo-inverted-focused: #fff,
    solo-inverted-focused-text: rgba(#000, .87)
  },
  list-tile: {
    hover: rgba(#fff, .08)
  },
  buttons: {
    disabled: rgba(#fff, .3),
    focused: rgba(#fff, .12),
    focused-alt: rgba(#fff, .1),
    pressed: rgba(#ccc, .25)
  },
  expansion-panels: {
    focus: #1f3f28
  },
  selection-controls: {
    thumb: {
      inactive: #bdbdbd,
      disabled: #1a3a22
    },
    track: {
      inactive: rgba(#fff, .3),
      disabled: rgba(#fff, .1)
    }
  },
  slider: {
    active: rgba(#fff, .3),
    inactive: rgba(#fff, .2),
    disabled: rgba(#fff, .2),
    discrete: #fff
  },
  tabs: {
    active: #fff
  },
  text-fields: {
    box: rgba(#000, .1),
    box-hover: rgba(#000, .2),
    box-focus: rgba(#000, .3)
  },
  input-bottom-line: rgba(#fff, .7),

  stepper: {
    active: rgba(#fff, 1),
    completed: rgba(#fff, 0.87),
    hover: rgba(#fff, 0.75)
  },
  table: {
    active: #22452c
    hover: #285a34
    border: #285a34
  },
  picker: {
    body: #1a3a22,
    clock: #285a34,
    indeterminateTime: #336b40,
    title: #285a34
  },
  bg-color: #0f2213
  fg-color: #fff
  text-color: #fff
  primary-text-percent: 1
  secondary-text-percent: .70
  disabledORhints-text-percent: .50
  divider-percent: .12
  active-icon-percent: 1
  inactive-icon-percent: .50
  calendar: {
    background-color: #0f2213
    outside-background-color: #08140b
    line-color: #9e9e9e
    interval-color: #eeeeee
    interval-line-color: #285a34
    text-color: #fff
    past-color: rgba(#fff, .50)
  }
}
